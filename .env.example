# Caspian API Configuration
CASPIAN_API_KEY=your_caspian_api_key_here
CASPIAN_BASE_URL=https://api.trycaspianai.com

# Channel Bot Credentials (Free channels need no platform billing)
# Telegram Bot Token from @BotFather (e.g. 123456789:ABCdefGHI...)
TELEGRAM_BOT_TOKEN=

# Discord Bot Token (for connect_discord) or leave blank if using shared install_discord
DISCORD_BOT_TOKEN=
DISCORD_DISPLAY_NAME=TripCaspian

# Email Username (e.g., "tripcaspian" -> tripcaspian@agents.trycaspianai.com)
EMAIL_USERNAME=tripcaspian

# Provider Mode Configuration (mock | live)
PROVIDER_MODE=mock

# Optional live provider API keys (if PROVIDER_MODE=live)
IRCTC_PARTNER_KEY=
REDBUS_PARTNER_KEY=

# Official Uber Rides Python SDK Configuration
UBER_SERVER_TOKEN=
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_REDIRECT_URI=http://localhost:8000/oauth/callback
UBER_SANDBOX=true

# Storage & Application Settings
DATABASE_PATH=tripcaspian.db
MAX_CONCESSION=0.10
CONCESSION_STEP=0.05
WATCHER_POLL_INTERVAL=30
